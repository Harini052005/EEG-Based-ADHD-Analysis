# ==============================================================================
# Git Ignore Rules for EEG Pediatric ADHD Analysis
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# EEG Raw & Processed Datasets (Never commit large raw/clinical signals)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# EEG File Formats & Archives
*.mat
*.edf
*.set
*.fdt
*.bdf
*.fif
*.zip
*.tar.gz
*.7z

# Output figures and temporary plots
results/figures/*.png
results/figures/*.pdf
results/figures/*.svg
!results/figures/.gitkeep

# Output metrics logs
results/metrics/*.csv
results/metrics/*.json
!results/metrics/.gitkeep

# Trained Machine Learning Model Binaries
backend/models/*.joblib
backend/models/*.pkl
backend/models/*.h5
backend/models/*.onnx
!backend/models/.gitkeep

# Empty directory keepers
!report/.gitkeep
!frontend/assets/.gitkeep

# IDE and Operating System Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
